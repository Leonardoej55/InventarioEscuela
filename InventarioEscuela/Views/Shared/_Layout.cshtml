@using System.Security.Claims

@{
    string controladorActual =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string nombreUsuario =
        User.FindFirst(ClaimTypes.Name)?.Value
        ?? User.Identity?.Name
        ?? "Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventario Institucional</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <div class="sistema-container">

        <aside class="menu-lateral">
            <div class="logo-escuela">
                <div class="nombre-escuela">
                    Escuela<br />
                    Proyecto<br />
                    Pacuare
                </div>
            </div>

            <nav class="opciones-menu">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="opcion-menu @(controladorActual == "Home" ? "activo" : "")">
                    <span class="icono-menu">🏠</span>
                    <span>Página principal</span>
                </a>

                <a asp-controller="Inventario"
                   asp-action="Index"
                   class="opcion-menu @(controladorActual == "Inventario" ? "activo" : "")">
                    <span class="icono-menu">📦</span>
                    <span>Inventario<br />institucional</span>
                </a>

                <a asp-controller="Movimientos"
                   asp-action="Index"
                   class="opcion-menu @(controladorActual == "Movimientos" ? "activo" : "")">
                    <span class="icono-menu">🏠</span>
                    <span>Movimientos</span>
                </a>

                <a asp-controller="Mantenimiento"
                   asp-action="Index"
                   class="opcion-menu @(controladorActual == "Mantenimiento" ? "activo" : "")">
                    <span class="icono-menu">🛠️</span>
                    <span>Mantenimiento</span>
                </a>

                <a asp-controller="Reportes"
                   asp-action="Index"
                   class="opcion-menu @(controladorActual == "Reportes" ? "activo" : "")">
                    <span class="icono-menu">📋</span>
                    <span>Reportes</span>
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Login"
                       asp-action="Registro"
                       class="opcion-menu @(controladorActual == "Login" ? "activo" : "")">
                        <span class="icono-menu">👥</span>
                        <span>Registrar usuario</span>
                    </a>
                }
            </nav>

            <div class="perfil-sidebar-container">
                <a asp-controller="Perfil"
                   asp-action="Index"
                   class="opcion-menu perfil-sidebar-link @(controladorActual == "Perfil" ? "activo" : "")">
                    <span class="icono-menu">👤</span>
                    <span>Perfil</span>
                </a>
            </div>
        </aside>

        <div class="contenido-sistema">
            <header class="barra-superior">
                <div class="titulo-sistema">
                    <h1>Escuela Proyecto Pacuare</h1>
                    <p class="subtitulo">
                        Registro y control del movimiento
                        de los activos dentro de la escuela
                    </p>
                </div>

                <div class="usuario-sistema">
                    <span class="bienvenido">Bienvenido</span>

                    <div class="user-info">
                        <span class="user-name">@nombreUsuario</span>

                        <form asp-controller="Home"
                              asp-action="CerrarSesion"
                              method="post"
                              style="margin:0;">
                            <button type="submit"
                                    class="cerrar-sesion-link"
                                    style="padding:0;border:0;background:none;font-family:inherit;cursor:pointer;">
                                Cerrar Sesión
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <main class="contenido-principal" role="main">
                @RenderBody()
            </main>

            <footer class="pie-pagina">
                © 2026 - Inventario Institucional
            </footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>