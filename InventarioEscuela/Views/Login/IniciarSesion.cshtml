@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />
    <meta name="viewport"content="width=device-width, initial-scale=1.0" />

    <title>Inicio de sesión - InventarioEscuela</title>

        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>


<body class="pagina-login">

    <div class="login-container">


        <!-- ======================================
             PANEL IZQUIERDO
             ======================================= -->

        <div class="left-panel">

            <div class="school-name">
                Escuela Proyecto<br />
                Pacuare
            </div>

            <div class="school-subtitle">
                Gestion de inventario
            </div>

        </div>


        <!-- ======================================
             PANEL DERECHO
             ======================================= -->

        <div class="right-panel">


            <!-- CONTENEDOR DEL LOGIN -->

            <div class="login-box">


                <!-- TÍTULO -->

                <h1 class="login-title">
                    Inicio de sesion
                </h1>


                <!-- FORMULARIO -->

                <form asp-controller="Login"
                      asp-action="IniciarSesion"
                      method="post">


                    <!-- CORREO -->

                    <div class="input-row">

                        <label for="correo">
                            Usuario:
                        </label>

                        <input type="text"
                               id="correo"
                               name="correo"
                               autocomplete="username"
                               required />

                    </div>


                    <!-- CONTRASEÑA -->

                    <div class="input-row">

                        <label for="clave">
                            Contraseña:
                        </label>

                        <input type="password"
                               id="clave"
                               name="clave"
                               autocomplete="current-password"
                               required />

                    </div>


                    <!-- BOTÓN -->

                    <div class="button-container">

                        <button type="submit"
                                class="login-button">

                            Log In

                        </button>

                    </div>


                    <!-- MENSAJE DE ERROR -->
                    @if (ViewData["Mensaje"] != null)
                    {

                        <div class="error-message">

                            @ViewData["Mensaje"]

                        </div>

                    }


                    <!-- REGISTRO -->

                    <div class="register-link">
                        Para obtener una cuenta, contacta al administrador.
                    </div>

                </form>

            </div>

        </div>

    </div>

</body>

</html>