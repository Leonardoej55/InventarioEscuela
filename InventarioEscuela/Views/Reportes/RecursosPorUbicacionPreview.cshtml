@model InventarioEscuela.ViewModels.ReporteRecursosPorUbicacionViewModel
@{
    ViewData["Title"] = "Inventario por ubicación · Resultados";
    ViewData["AccionReporte"] = "RecursosPorUbicacion";
    int desde = Model.TotalResultados == 0 ? 0 : (Model.PaginaActual - 1) * Model.TamanoPagina + 1;
    int hasta = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalResultados);
    Dictionary<string, string> RutasUbicacion(int idUbicacion)
    {
        var rutas = InventarioEscuela.ViewModels.RutasReporte.Crear(Model);
        rutas["idUbicacionFiltro"] = idUbicacion.ToString();
        return rutas;
    }
}
<div class="rpt-page">
    <a asp-controller="Reportes" asp-action="Index" class="rpt-back">← Todos los reportes</a>
    <header class="rpt-header">
        <h2>Inventario por ubicación</h2>
        <p>Consulte los resultados y descargue el reporte completo cuando lo necesite.</p>
    </header>
    <partial name="_ErroresReporte" />
    <partial name="_FiltrosAplicados" model="Model" />
    <dl class="rpt-totals">
        <div><dt>Activos incluidos</dt><dd>@Model.TotalResultados</dd></div>
        <div><dt>Ubicaciones con resultados</dt><dd>@Model.TotalUbicaciones</dd></div>
    </dl>
    <section class="rpt-annual" aria-labelledby="hoja-anual">
        <h3 id="hoja-anual">Revisión anual en tres pasos</h3>
        <p>Imprima la hoja de verificación, compruebe los activos en el lugar y anote las diferencias a mano. Después use «Actualizar» junto al activo para guardar las correcciones en Inventario.</p>
        <p class="rpt-help">Esta consulta muestra lo registrado actualmente. Descargar la hoja no modifica el inventario ni guarda el resultado del conteo.</p>
    </section>
    <partial name="_AccionesReporte" model="Model" />
    @if (Model.ResumenUbicaciones.Any())
    {
        <section aria-labelledby="resumen-ubicaciones">
            <h3 id="resumen-ubicaciones">Resumen de todas las ubicaciones incluidas</h3>
            <div class="dashboard-table-container rpt-table-wrap" role="region" aria-label="Resumen por ubicación" tabindex="0">
                <table class="tabla-base dashboard-table rpt-table rpt-summary-table">
                    <caption>Totales de todos los resultados filtrados, sin limitarse a la página actual.</caption>
                    <thead><tr><th scope="col">Ubicación</th><th scope="col">Activos</th><th scope="col">Funcionales / buenos</th><th scope="col">Dañados / malos</th><th scope="col">En mantenimiento</th><th scope="col">Otros estados</th></tr></thead>
                    <tbody>
                        @foreach (var ubicacion in Model.ResumenUbicaciones)
                        {
                            <tr>
                                <th scope="row"><a asp-controller="Reportes" asp-action="RecursosPorUbicacionPreview" asp-all-route-data="@RutasUbicacion(ubicacion.IdUbicacion)" aria-label="Consultar activos en @ubicacion.Ubicacion">@ubicacion.Ubicacion</a></th>
                                <td>@ubicacion.Total</td>
                                <td>@ubicacion.Funcionales</td>
                                <td>@ubicacion.Danados</td>
                                <td>@ubicacion.EnMantenimiento</td>
                                <td>@ubicacion.Otros</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    <h3>Detalle de resultados</h3>
    <p class="rpt-result-count">Mostrando <strong>@desde–@hasta</strong> de <strong>@Model.TotalResultados</strong> registros. Los totales y las descargas corresponden a todos los resultados.</p>
    <p class="rpt-table-hint">Deslice la tabla hacia los lados para consultar todas las columnas.</p>
    <div class="dashboard-table-container rpt-table-wrap" role="region" aria-label="Detalle del reporte" tabindex="0">
        <table class="tabla-base dashboard-table rpt-table">
            <caption>Inventario por ubicación: resultados de la página actual.</caption>
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Descripción</th>
                    <th scope="col">Marca</th>
                    <th scope="col">Modelo</th>
                    <th scope="col">Serie</th>
                    <th scope="col">Ubicación</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Modo de adquisición</th>
                    <th scope="col">Consultar o actualizar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Activos.Any())
                {
                    foreach (var activo in Model.Activos)
                    {
                        <tr>
                            <td>@activo.NumeroIdentificacion</td>
                            <td>@activo.Descripcion</td>
                            <td>@(activo.Marca?.MarcaNombre ?? "No informado")</td>
                            <td>@(string.IsNullOrWhiteSpace(activo.Modelo) ? "No informado" : activo.Modelo)</td>
                            <td>@(string.IsNullOrWhiteSpace(activo.Serie) ? "No informado" : activo.Serie)</td>
                            <td>@(activo.Ubicacion?.UbicacionNombre ?? "Sin ubicación")</td>
                            <td>@(activo.EstadoActivo?.Estado ?? "No informado")</td>
                            <td>@(activo.ModoAdquisicion?.NombreModoAdquisicion ?? "No informado")</td>
                            <td><partial name="_AccionesActivo" model="activo" /></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="rpt-empty">No se encontraron resultados con estos filtros. Puede modificarlos o limpiarlos para ampliar la consulta.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacion" model="Model" />
    <p class="rpt-help">Use «Ver activo» para consultar sus datos. Administradores y secretarios pueden corregir estado u observaciones con «Editar». Para cambiar la ubicación, use «trasladar» y conserve el historial del activo.</p>
</div>
