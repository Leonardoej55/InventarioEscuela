@model InventarioEscuela.ViewModels.ReporteRecursosPorUbicacionViewModel
@{
    ViewData["Title"] = "Inventario por ubicación";
    bool avanzados = !ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(Model.CodigoFiltro) || Model.IdMarcaFiltro.HasValue || Model.IdEstadoFiltro.HasValue || Model.IdModoFiltro.HasValue;
}
<div class="rpt-page">
    <a asp-controller="Reportes" asp-action="Index" class="rpt-back">← Todos los reportes</a>
    <header class="rpt-header">
        <h2>Inventario por ubicación</h2>
        <p>Elija un aula, oficina o almacén para consultar sus activos y preparar la revisión anual. Sin elegir ubicación se incluyen todas.</p>
    </header>
    <partial name="_ErroresReporte" />
    <form asp-controller="Reportes" asp-action="RecursosPorUbicacionPreview" method="get" class="rpt-form">
        <div class="rpt-fields">
            <div class="rpt-field">
                <label for="idUbicacionFiltro">Ubicación</label>
                <select asp-for="IdUbicacionFiltro" name="idUbicacionFiltro" id="idUbicacionFiltro">
                    <option value="">Todas las ubicaciones</option>
                    @foreach (var opcion in Model.Ubicaciones)
                    {
                        <option value="@opcion.IdUbicacion">@opcion.UbicacionNombre</option>
                    }
                </select>
                <span asp-validation-for="IdUbicacionFiltro" class="rpt-field-error"></span>
            </div>
            <div class="rpt-field">
                <label for="descripcionFiltro">Descripción del activo</label>
                <input asp-for="DescripcionFiltro" name="descripcionFiltro" id="descripcionFiltro" type="text" />
                <span asp-validation-for="DescripcionFiltro" class="rpt-field-error"></span>
            </div>
        </div>
        <p class="rpt-callout">Para revisar todo un lugar, seleccione solo la ubicación y deje los demás filtros vacíos. Se incluyen también los activos registrados en años anteriores. Después podrá imprimir una hoja para anotar lo encontrado.</p>
        <details class="rpt-advanced" open="@(avanzados ? "open" : null)">
            <summary>Más filtros (opcionales)</summary>
            <div class="rpt-fields">
                <div class="rpt-field">
                    <label for="codigoFiltro">Código</label>
                    <input asp-for="CodigoFiltro" name="codigoFiltro" id="codigoFiltro" type="text" />
                    <span asp-validation-for="CodigoFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="idMarcaFiltro">Marca</label>
                    <select asp-for="IdMarcaFiltro" name="idMarcaFiltro" id="idMarcaFiltro">
                        <option value="">Todas las marcas</option>
                        @foreach (var opcion in Model.Marcas)
                        {
                            <option value="@opcion.IdMarca">@opcion.MarcaNombre</option>
                        }
                    </select>
                    <span asp-validation-for="IdMarcaFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="idEstadoFiltro">Estado</label>
                    <select asp-for="IdEstadoFiltro" name="idEstadoFiltro" id="idEstadoFiltro">
                        <option value="">Todos los estados</option>
                        @foreach (var opcion in Model.Estados)
                        {
                            <option value="@opcion.IdEstado">@opcion.Estado</option>
                        }
                    </select>
                    <span asp-validation-for="IdEstadoFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="idModoFiltro">Modo de adquisición</label>
                    <select asp-for="IdModoFiltro" name="idModoFiltro" id="idModoFiltro">
                        <option value="">Todos los modos</option>
                        @foreach (var opcion in Model.ModosAdquisicion)
                        {
                            <option value="@opcion.IdModoAdquisicion">@opcion.NombreModoAdquisicion</option>
                        }
                    </select>
                    <span asp-validation-for="IdModoFiltro" class="rpt-field-error"></span>
                </div>
            </div>
        </details>
        <div class="rpt-actions">
            <button type="submit" class="rpt-button">Consultar resultados</button>
            <a asp-controller="Reportes" asp-action="RecursosPorUbicacion" class="rpt-button rpt-button-secondary">Limpiar filtros</a>
        </div>
    </form>
</div>
