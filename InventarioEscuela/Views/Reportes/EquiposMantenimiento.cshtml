@model InventarioEscuela.ViewModels.ReporteEquiposMantenimientoViewModel
@{
    ViewData["Title"] = "Historial de mantenimientos";
    bool avanzados = !ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(Model.CodigoFiltro) || Model.IdMarcaFiltro.HasValue || !string.IsNullOrWhiteSpace(Model.ModeloFiltro) || !string.IsNullOrWhiteSpace(Model.SerieFiltro) || Model.IdTipoFiltro.HasValue || !string.IsNullOrWhiteSpace(Model.ResponsableFiltro);
}
<div class="rpt-page">
    <a asp-controller="Reportes" asp-action="Index" class="rpt-back">← Todos los reportes</a>
    <header class="rpt-header">
        <h2>Historial de mantenimientos</h2>
        <p>Consulte las intervenciones registradas. Un activo puede aparecer más de una vez; cada fila corresponde a un mantenimiento, no a un equipo pendiente.</p>
    </header>
    <partial name="_ErroresReporte" />
    <form asp-controller="Reportes" asp-action="EquiposMantenimientoPreview" method="get" class="rpt-form">
        <div class="rpt-fields">
            <div class="rpt-field">
                <label for="idUbicacionFiltro">Ubicación actual del activo</label>
                <select asp-for="IdUbicacionFiltro" name="idUbicacionFiltro" id="idUbicacionFiltro">
                    <option value="">Todas las ubicaciones</option>
                    @foreach (var opcion in Model.Ubicaciones)
                    {
                        <option value="@opcion.IdUbicacion">@opcion.UbicacionNombre</option>
                    }
                </select>
                <span asp-validation-for="IdUbicacionFiltro" class="rpt-field-error"></span>
            </div>
            <div class="rpt-field">
                <label for="descripcionFiltro">Descripción del activo</label>
                <input asp-for="DescripcionFiltro" name="descripcionFiltro" id="descripcionFiltro" type="text" />
                <span asp-validation-for="DescripcionFiltro" class="rpt-field-error"></span>
            </div>
            <div class="rpt-field">
                <label for="fechaDesde">Fecha de mantenimiento desde</label>
                <input asp-for="FechaDesde" name="fechaDesde" id="fechaDesde" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="FechaDesde" class="rpt-field-error"></span>
            </div>
            <div class="rpt-field">
                <label for="fechaHasta">Fecha de mantenimiento hasta, inclusive</label>
                <input asp-for="FechaHasta" name="fechaHasta" id="fechaHasta" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="FechaHasta" class="rpt-field-error"></span>
            </div>
        </div>
        <details class="rpt-advanced" open="@(avanzados ? "open" : null)">
            <summary>Más filtros (opcionales)</summary>
            <div class="rpt-fields">
                <div class="rpt-field">
                    <label for="codigoFiltro">Código</label>
                    <input asp-for="CodigoFiltro" name="codigoFiltro" id="codigoFiltro" type="text" />
                    <span asp-validation-for="CodigoFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="idMarcaFiltro">Marca</label>
                    <select asp-for="IdMarcaFiltro" name="idMarcaFiltro" id="idMarcaFiltro">
                        <option value="">Todas las marcas</option>
                        @foreach (var opcion in Model.Marcas)
                        {
                            <option value="@opcion.IdMarca">@opcion.MarcaNombre</option>
                        }
                    </select>
                    <span asp-validation-for="IdMarcaFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="modeloFiltro">Modelo</label>
                    <input asp-for="ModeloFiltro" name="modeloFiltro" id="modeloFiltro" type="text" />
                    <span asp-validation-for="ModeloFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="serieFiltro">Número de serie</label>
                    <input asp-for="SerieFiltro" name="serieFiltro" id="serieFiltro" type="text" />
                    <span asp-validation-for="SerieFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="idTipoFiltro">Tipo de mantenimiento</label>
                    <select asp-for="IdTipoFiltro" name="idTipoFiltro" id="idTipoFiltro">
                        <option value="">Todos los tipos</option>
                        @foreach (var opcion in Model.TiposMantenimiento)
                        {
                            <option value="@opcion.IdTipo">@opcion.Mantenimiento</option>
                        }
                    </select>
                    <span asp-validation-for="IdTipoFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="responsableFiltro">Responsable</label>
                    <input asp-for="ResponsableFiltro" name="responsableFiltro" id="responsableFiltro" type="text" />
                    <span asp-validation-for="ResponsableFiltro" class="rpt-field-error"></span>
                </div>
            </div>
        </details>
        <p class="rpt-help">Las fechas corresponden al mantenimiento. La ubicación es la actual del activo. El historial no indica si una intervención sigue abierta o ya terminó.</p>
        <div class="rpt-actions">
            <button type="submit" class="rpt-button">Consultar resultados</button>
            <a asp-controller="Reportes" asp-action="EquiposMantenimiento" class="rpt-button rpt-button-secondary">Limpiar filtros</a>
        </div>
    </form>
</div>
