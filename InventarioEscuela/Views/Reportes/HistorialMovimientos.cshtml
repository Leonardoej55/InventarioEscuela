@model InventarioEscuela.ViewModels.ReporteHistorialMovimientosViewModel
@{
    ViewData["Title"] = "Historial de movimientos";
    bool avanzados = !ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(Model.DescripcionFiltro) || Model.IdUbicacionOrigenFiltro.HasValue || Model.IdUbicacionDestinoFiltro.HasValue || !string.IsNullOrWhiteSpace(Model.ResponsableFiltro) || !string.IsNullOrWhiteSpace(Model.ObservacionFiltro);
}
<div class="rpt-page">
    <a asp-controller="Reportes" asp-action="Index" class="rpt-back">← Todos los reportes</a>
    <header class="rpt-header">
        <h2>Historial de movimientos</h2>
        <p>Consulte los traslados registrados en un período o busque el recorrido de un activo. Todos los filtros son opcionales.</p>
    </header>
    <partial name="_ErroresReporte" />
    <form asp-controller="Reportes" asp-action="HistorialMovimientosPreview" method="get" class="rpt-form">
        <div class="rpt-fields">
            <div class="rpt-field">
                <label for="codigoFiltro">Código</label>
                <input asp-for="CodigoFiltro" name="codigoFiltro" id="codigoFiltro" type="text" />
                <span asp-validation-for="CodigoFiltro" class="rpt-field-error"></span>
            </div>
            <div class="rpt-field">
                <label for="fechaDesde">Fecha de movimiento desde</label>
                <input asp-for="FechaDesde" name="fechaDesde" id="fechaDesde" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="FechaDesde" class="rpt-field-error"></span>
            </div>
            <div class="rpt-field">
                <label for="fechaHasta">Fecha de movimiento hasta, inclusive</label>
                <input asp-for="FechaHasta" name="fechaHasta" id="fechaHasta" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="FechaHasta" class="rpt-field-error"></span>
            </div>
        </div>
        <details class="rpt-advanced" open="@(avanzados ? "open" : null)">
            <summary>Más filtros (opcionales)</summary>
            <div class="rpt-fields">
                <div class="rpt-field">
                    <label for="descripcionFiltro">Descripción del activo</label>
                    <input asp-for="DescripcionFiltro" name="descripcionFiltro" id="descripcionFiltro" type="text" />
                    <span asp-validation-for="DescripcionFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="idUbicacionOrigenFiltro">Ubicación de origen</label>
                    <select asp-for="IdUbicacionOrigenFiltro" name="idUbicacionOrigenFiltro" id="idUbicacionOrigenFiltro">
                        <option value="">Todos los orígenes</option>
                        @foreach (var opcion in Model.Ubicaciones)
                        {
                            <option value="@opcion.IdUbicacion">@opcion.UbicacionNombre</option>
                        }
                    </select>
                    <span asp-validation-for="IdUbicacionOrigenFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="idUbicacionDestinoFiltro">Ubicación de destino</label>
                    <select asp-for="IdUbicacionDestinoFiltro" name="idUbicacionDestinoFiltro" id="idUbicacionDestinoFiltro">
                        <option value="">Todos los destinos</option>
                        @foreach (var opcion in Model.Ubicaciones)
                        {
                            <option value="@opcion.IdUbicacion">@opcion.UbicacionNombre</option>
                        }
                    </select>
                    <span asp-validation-for="IdUbicacionDestinoFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="responsableFiltro">Responsable</label>
                    <input asp-for="ResponsableFiltro" name="responsableFiltro" id="responsableFiltro" type="text" />
                    <span asp-validation-for="ResponsableFiltro" class="rpt-field-error"></span>
                </div>
                <div class="rpt-field">
                    <label for="observacionFiltro">Texto de la observación</label>
                    <input asp-for="ObservacionFiltro" name="observacionFiltro" id="observacionFiltro" type="text" />
                    <span asp-validation-for="ObservacionFiltro" class="rpt-field-error"></span>
                </div>
            </div>
        </details>
        <p class="rpt-help">Las fechas corresponden al traslado. Si deja el período vacío se consulta todo el historial.</p>
        <div class="rpt-actions">
            <button type="submit" class="rpt-button">Consultar resultados</button>
            <a asp-controller="Reportes" asp-action="HistorialMovimientos" class="rpt-button rpt-button-secondary">Limpiar filtros</a>
        </div>
    </form>
</div>
