@model InventarioEscuela.ViewModels.ReporteHistorialMovimientosViewModel
@{
    ViewData["Title"] = "Historial de movimientos · Resultados";
    ViewData["AccionReporte"] = "HistorialMovimientos";
    int desde = Model.TotalResultados == 0 ? 0 : (Model.PaginaActual - 1) * Model.TamanoPagina + 1;
    int hasta = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalResultados);
}
<div class="rpt-page">
    <a asp-controller="Reportes" asp-action="Index" class="rpt-back">← Todos los reportes</a>
    <header class="rpt-header">
        <h2>Historial de movimientos</h2>
        <p>Consulte los resultados y descargue el reporte completo cuando lo necesite.</p>
    </header>
    <partial name="_ErroresReporte" />
    <partial name="_FiltrosAplicados" model="Model" />
    <dl class="rpt-totals">
        <div><dt>Movimientos registrados</dt><dd>@Model.TotalMovimientos</dd></div>
        <div><dt>Activos distintos</dt><dd>@Model.TotalActivosMovidos</dd></div>
        <div><dt>Ubicaciones de origen</dt><dd>@Model.TotalUbicacionesOrigen</dd></div>
        <div><dt>Ubicaciones de destino</dt><dd>@Model.TotalUbicacionesDestino</dd></div>
    </dl>
    <partial name="_AccionesReporte" model="Model" />
    <h3>Detalle de resultados</h3>
    <p class="rpt-result-count">Mostrando <strong>@desde–@hasta</strong> de <strong>@Model.TotalResultados</strong> registros. Los totales y las descargas corresponden a todos los resultados.</p>
    <p class="rpt-table-hint">Deslice la tabla hacia los lados para consultar todas las columnas.</p>
    <div class="dashboard-table-container rpt-table-wrap" role="region" aria-label="Detalle del reporte" tabindex="0">
        <table class="tabla-base dashboard-table rpt-table">
            <caption>Historial de movimientos: resultados de la página actual.</caption>
            <thead>
                <tr>
                    <th scope="col">Fecha del movimiento</th>
                    <th scope="col">Código</th>
                    <th scope="col">Descripción</th>
                    <th scope="col">Origen</th>
                    <th scope="col">Destino</th>
                    <th scope="col">Responsable</th>
                    <th scope="col">Observación</th>
                    <th scope="col" class="rpt-actions-column">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Movimientos.Any())
                {
                    foreach (var movimiento in Model.Movimientos)
                    {
                        <tr>
                            <td>@movimiento.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(movimiento.Activo?.NumeroIdentificacion ?? "No informado")</td>
                            <td>@(movimiento.Activo?.Descripcion ?? "No informado")</td>
                            <td>@(movimiento.MovimientosOrigen?.UbicacionNombre ?? "Sin origen registrado")</td>
                            <td>@(movimiento.MovimientosDestino?.UbicacionNombre ?? "No informado")</td>
                            <td>@(string.IsNullOrWhiteSpace(movimiento.Responsable) ? "No informado" : movimiento.Responsable)</td>
                            <td>@(string.IsNullOrWhiteSpace(movimiento.Observacion) ? "Sin observación" : movimiento.Observacion)</td>
                            <td class="acciones">
                                @if (movimiento.Activo != null)
                                {
                                    <partial name="_AccionesActivo" model="movimiento.Activo" />
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="rpt-empty">No se encontraron resultados con estos filtros. Puede modificarlos o limpiarlos para ampliar la consulta.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacion" model="Model" />
    <p class="rpt-help">Use «Ver» para consultar sus datos. Administradores y secretarios pueden corregir estado u observaciones con «Editar». Para cambiar la ubicación, use «Trasladar» y conserve el historial del activo.</p>
</div>
