@model InventarioEscuela.ViewModels.ReporteEquiposDanadosViewModel
@{
    ViewData["Title"] = "Activos dañados · Resultados";
    ViewData["AccionReporte"] = "EquiposDanados";
    int desde = Model.TotalResultados == 0 ? 0 : (Model.PaginaActual - 1) * Model.TamanoPagina + 1;
    int hasta = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalResultados);
}
<div class="rpt-page">
    <a asp-controller="Reportes" asp-action="Index" class="rpt-back">← Todos los reportes</a>
    <header class="rpt-header">
        <h2>Activos dañados</h2>
        <p>Consulte los resultados y descargue el reporte completo cuando lo necesite.</p>
    </header>
    <partial name="_ErroresReporte" />
    <partial name="_FiltrosAplicados" model="Model" />
    <dl class="rpt-totals">
        <div><dt>Activos dañados</dt><dd>@Model.TotalResultados</dd></div>
        <div><dt>Ubicaciones afectadas</dt><dd>@Model.TotalUbicaciones</dd></div>
        <div><dt>Con observación</dt><dd>@Model.TotalConObservacion</dd></div>
    </dl>
    <partial name="_AccionesReporte" model="Model" />
    <h3>Detalle de resultados</h3>
    <p class="rpt-result-count">Mostrando <strong>@desde–@hasta</strong> de <strong>@Model.TotalResultados</strong> registros. Los totales y las descargas corresponden a todos los resultados.</p>
    <p class="rpt-table-hint">Deslice la tabla hacia los lados para consultar todas las columnas.</p>
    <div class="dashboard-table-container rpt-table-wrap" role="region" aria-label="Detalle del reporte" tabindex="0">
        <table class="tabla-base dashboard-table rpt-table">
            <caption>Activos dañados: resultados de la página actual.</caption>
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Descripción</th>
                    <th scope="col">Marca</th>
                    <th scope="col">Modelo</th>
                    <th scope="col">Serie</th>
                    <th scope="col">Ubicación</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Observación</th>
                    <th scope="col">Consultar o actualizar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Activos.Any())
                {
                    foreach (var activo in Model.Activos)
                    {
                        <tr>
                            <td>@activo.NumeroIdentificacion</td>
                            <td>@activo.Descripcion</td>
                            <td>@(activo.Marca?.MarcaNombre ?? "No informado")</td>
                            <td>@(string.IsNullOrWhiteSpace(activo.Modelo) ? "No informado" : activo.Modelo)</td>
                            <td>@(string.IsNullOrWhiteSpace(activo.Serie) ? "No informado" : activo.Serie)</td>
                            <td>@(activo.Ubicacion?.UbicacionNombre ?? "Sin ubicación")</td>
                            <td>@(activo.EstadoActivo?.Estado ?? "No informado")</td>
                            <td>@(string.IsNullOrWhiteSpace(activo.Observacion) ? "Sin observación" : activo.Observacion)</td>
                            <td><partial name="_AccionesActivo" model="activo" /></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="rpt-empty">No se encontraron resultados con estos filtros. Puede modificarlos o limpiarlos para ampliar la consulta.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacion" model="Model" />
    <p class="rpt-help">Use «Ver activo» para consultar sus datos. Administradores y secretarios pueden corregir estado u observaciones con «Editar». Para cambiar la ubicación, use «trasladar» y conserve el historial del activo.</p>
</div>
