@model InventarioEscuela.ViewModels.ReporteEquiposMantenimientoViewModel
@{
    ViewData["Title"] = "Historial de mantenimientos · Resultados";
    ViewData["AccionReporte"] = "EquiposMantenimiento";
    int desde = Model.TotalResultados == 0 ? 0 : (Model.PaginaActual - 1) * Model.TamanoPagina + 1;
    int hasta = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalResultados);
}
<div class="rpt-page">
    <a asp-controller="Reportes" asp-action="Index" class="rpt-back">← Todos los reportes</a>
    <header class="rpt-header">
        <h2>Historial de mantenimientos</h2>
        <p>Consulte los resultados y descargue el reporte completo cuando lo necesite.</p>
    </header>
    <partial name="_ErroresReporte" />
    <partial name="_FiltrosAplicados" model="Model" />
    <dl class="rpt-totals">
        <div><dt>Intervenciones registradas</dt><dd>@Model.TotalResultados</dd></div>
        <div><dt>Activos distintos</dt><dd>@Model.TotalActivos</dd></div>
        <div><dt>Tipos de mantenimiento</dt><dd>@Model.TotalTiposMantenimiento</dd></div>
        <div><dt>Responsables</dt><dd>@Model.TotalResponsables</dd></div>
    </dl>
    <partial name="_AccionesReporte" model="Model" />
    <p class="rpt-callout">Cada fila es una intervención registrada. Un mismo activo puede aparecer varias veces; estos datos no permiten determinar cuáles mantenimientos siguen abiertos.</p>
    <h3>Detalle de resultados</h3>
    <p class="rpt-result-count">Mostrando <strong>@desde–@hasta</strong> de <strong>@Model.TotalResultados</strong> registros. Los totales y las descargas corresponden a todos los resultados.</p>
    <p class="rpt-table-hint">Deslice la tabla hacia los lados para consultar todas las columnas.</p>
    <div class="dashboard-table-container rpt-table-wrap" role="region" aria-label="Detalle del reporte" tabindex="0">
        <table class="tabla-base dashboard-table rpt-table">
            <caption>Historial de mantenimientos: resultados de la página actual.</caption>
            <thead>
                <tr>
                    <th scope="col">Fecha de mantenimiento</th>
                    <th scope="col">Código</th>
                    <th scope="col">Descripción del activo</th>
                    <th scope="col">Marca</th>
                    <th scope="col">Modelo</th>
                    <th scope="col">Ubicación actual</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Responsable</th>
                    <th scope="col">Observaciones</th>
                    <th scope="col" class="rpt-actions-column">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Mantenimientos.Any())
                {
                    foreach (var mantenimiento in Model.Mantenimientos)
                    {
                        <tr>
                            <td>@mantenimiento.FechaMantenimiento.ToString("dd/MM/yyyy")</td>
                            <td>@(mantenimiento.Activo?.NumeroIdentificacion ?? "No informado")</td>
                            <td>@(mantenimiento.Activo?.Descripcion ?? "No informado")</td>
                            <td>@(mantenimiento.Activo?.Marca?.MarcaNombre ?? "No informado")</td>
                            <td>@(string.IsNullOrWhiteSpace(mantenimiento.Activo?.Modelo) ? "No informado" : mantenimiento.Activo?.Modelo)</td>
                            <td>@(mantenimiento.Activo?.Ubicacion?.UbicacionNombre ?? "Sin ubicación")</td>
                            <td>@(mantenimiento.TipoMantenimiento?.Mantenimiento ?? "No informado")</td>
                            <td>@(string.IsNullOrWhiteSpace(mantenimiento.Responsable) ? "No informado" : mantenimiento.Responsable)</td>
                            <td>@(string.IsNullOrWhiteSpace(mantenimiento.Descripcion) ? "Sin observaciones" : mantenimiento.Descripcion)</td>
                            <td class="acciones">
                                @if (mantenimiento.Activo != null)
                                {
                                    <partial name="_AccionesActivo" model="mantenimiento.Activo" />
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="10" class="rpt-empty">No se encontraron resultados con estos filtros. Puede modificarlos o limpiarlos para ampliar la consulta.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacion" model="Model" />
    <p class="rpt-help">Use «Ver» para consultar sus datos. Administradores y secretarios pueden corregir estado u observaciones con «Editar». Para cambiar la ubicación, use «Trasladar» y conserve el historial del activo.</p>
</div>
